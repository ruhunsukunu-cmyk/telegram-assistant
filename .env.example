# Telegram Bot Token (Telegram'da @BotFather'dan ücretsiz alınır)
TELEGRAM_BOT_TOKEN=BURAYA_BOT_TOKENINI_YAPISTIR

# Varsayılan Şehir (Hava durumu için)
DEFAULT_CITY=Istanbul
TIMEZONE=Europe/Istanbul

# Kalıcı not, görev ve hatırlatıcılar için harici PostgreSQL bağlantısı.
# Boş bırakılırsa yalnızca yerel geliştirmeye uygun SQLite kullanılır.
DATABASE_URL=

# Render bunu otomatik sağlar. Başka bir sunucuda webhook için dış HTTPS adresini yazın.
WEBHOOK_URL=

# İsteğe bağlı: virgülle ayrılmış Telegram kullanıcı kimlikleri ve hata bildirim sohbeti
ALLOWED_USER_IDS=
ADMIN_CHAT_ID=

# İsteğe bağlı: Google Takvim > Ayarlar > Takvimi entegre et >
# "iCal biçiminde gizli adres". Bu değeri mesajla paylaşmayın.
CALENDAR_ICAL_URL=
CALENDAR_USER_ID=
CALENDAR_CHAT_ID=
# Takvim bildirimleri otomatik olarak 24 saat ve 2 saat önce gönderilir.

# İsteğe bağlı Gemini kişisel asistanı. Anahtarı yalnızca sunucunun gizli
# değişkenlerinde saklayın; Telegram mesajına veya GitHub'a yazmayın.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=900

# Her gün gönderilecek akıllı sabah özeti (TIMEZONE saat diliminde)
MORNING_BRIEFING_TIME=06:00
# Sabah koşusu hava bildirimi ve planlanan koşu saati
RUNNING_WEATHER_TIME=06:10
MORNING_RUN_TIME=07:00
MIDDAY_CHECK_TIME=13:30
EVENING_SUMMARY_TIME=21:00
WEEKLY_REVIEW_TIME=18:00
# Yalnızca kontrollü canlı test için geçici olarak true yapılmalıdır.
MORNING_BRIEFING_TEST_ON_START=false
