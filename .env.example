# Telegram Bot Token (Telegram'da @BotFather'dan ücretsiz alınır)
TELEGRAM_BOT_TOKEN=BURAYA_BOT_TOKENINI_YAPISTIR

# Varsayılan Şehir (Hava durumu için)
DEFAULT_CITY=Istanbul
TIMEZONE=Europe/Istanbul

# Kalıcı not, görev ve hatırlatıcılar için harici PostgreSQL bağlantısı.
# Boş bırakılırsa yalnızca yerel geliştirmeye uygun SQLite kullanılır.
DATABASE_URL=

# Render bunu otomatik sağlar. Başka bir sunucuda webhook için dış HTTPS adresini yazın.
WEBHOOK_URL=

# miniapp/index.html yayınlandıktan sonra HTTPS adresi
MINI_APP_URL=

# İsteğe bağlı: virgülle ayrılmış Telegram kullanıcı kimlikleri ve hata bildirim sohbeti
ALLOWED_USER_IDS=
ADMIN_CHAT_ID=

# İsteğe bağlı: Google Takvim > Ayarlar > Takvimi entegre et >
# "iCal biçiminde gizli adres". Bu değeri mesajla paylaşmayın.
CALENDAR_ICAL_URL=
CALENDAR_USER_ID=
CALENDAR_CHAT_ID=
CALENDAR_REMINDER_MINUTES=30
