# Telegram Bot Token (Telegram'da @BotFather'dan ücretsiz alınır)
TELEGRAM_BOT_TOKEN=BURAYA_BOT_TOKENINI_YAPISTIR

# Varsayılan Şehir (Hava durumu için)
DEFAULT_CITY=Istanbul
TIMEZONE=Europe/Istanbul

# Kalıcı not, görev ve hatırlatıcılar için harici PostgreSQL bağlantısı.
# Boş bırakılırsa yalnızca yerel geliştirmeye uygun SQLite kullanılır.
DATABASE_URL=

# Render bunu otomatik sağlar. Başka bir sunucuda webhook için dış HTTPS adresini yazın.
WEBHOOK_URL=
